{
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {
      "extensions": "github/gh-stack",
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "installYarnUsingApt": false,
      "nodeGypDependencies": false,
      "npmVersion": "lts",
      "nvmInstallPath": "/usr/local/share/nvm",
      "nvmVersion": "latest",
      "pnpmVersion": "latest",
      "version": "lts"
    }
  },
  "image": "mcr.microsoft.com/devcontainers/rust:2.0.16-trixie",
  "name": "bingo",
  "postCreateCommand": "cargo install wasm-bindgen-cli --version '=0.2.127' --locked"
}
