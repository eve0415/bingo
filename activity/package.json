{
  "name": "@bingo/activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @bingo/wasm build",
    "dev": "vite dev",
    "prebuild": "pnpm --filter @bingo/wasm build",
    "build": "vite build",
    "predeploy": "pnpm build",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-file .dev.vars.example",
    "generate": "pnpm types && pnpm build",
    "pretest": "pnpm --filter @bingo/wasm build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @bingo/wasm build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bingo/wasm": "workspace:*",
    "@bingo/wrapper": "workspace:*",
    "@discord/embedded-app-sdk": "2.5.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
