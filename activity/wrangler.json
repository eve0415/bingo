{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bingo-activity",
  "compatibility_date": "2026-08-22",
  "main": "./src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "logpush": true,
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "services": [
    {
      "binding": "WRAPPER",
      "service": "bingo"
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
