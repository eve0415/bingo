{
  "name": "bingo",
  "private": true,
  "type": "module",
  "scripts": {
    "prelint": "pnpm -C wrapper generate && pnpm -C activity generate",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
    "prelint:check": "pnpm -C wrapper generate && pnpm -C activity generate",
    "lint:check": "oxlint && oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.1.0"
}
