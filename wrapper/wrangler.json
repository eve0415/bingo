{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bingo",
  "compatibility_date": "2026-08-22",
  "main": "./src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "logpush": true,
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
